// Olang Grammar Definition
// Supports functions, pipelines, pattern matching, and minimal syntax

WHITESPACE  = _{ " " | "\t" | NEWLINE }
NEWLINE     = _{ "\n" | "\r\n" }
COMMENT     = _{ "//" ~ (!NEWLINE ~ ANY)* }

// Identifiers and literals
identifier  = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
integer     = @{ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
float       = @{ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
string      = @{ "\"" ~ string_char* ~ "\"" }
raw_string  = @{ "r\"" ~ (!"\"" ~ ANY)* ~ "\"" }
template_string = { "`" ~ template_part* ~ "`" }
template_part = { template_interpolation | template_literal_text }
template_literal_text = @{ (!("`" | "${") ~ ANY)+ }
string_char = { !("\"" | "\\") ~ ANY | escape_sequence }

escape_sequence = { "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | "0" | "x" ~ ASCII_HEX_DIGIT{2} | "u" ~ ASCII_HEX_DIGIT{4} | "u{" ~ ASCII_HEX_DIGIT+ ~ "}") }
template_escape = { "\\" ~ ("`" | "$" | "\\") }
template_interpolation = { "${" ~ expr ~ "}" }
boolean     = { "true" | "false" }
char_literal = @{ "'" ~ (!"'" ~ ANY) ~ "'" }

// Enhanced numeric literals
binary      = @{ ("+" | "-")? ~ "0b" ~ ASCII_BIN_DIGIT+ ~ ("_" ~ ASCII_BIN_DIGIT+)* }
octal       = @{ ("+" | "-")? ~ "0o" ~ ASCII_OCT_DIGIT+ ~ ("_" ~ ASCII_OCT_DIGIT+)* }
hex         = @{ ("+" | "-")? ~ "0x" ~ ASCII_HEX_DIGIT+ ~ ("_" ~ ASCII_HEX_DIGIT+)* }
number      = { float | binary | octal | hex | integer }

// Lists and tuples
list        = { "[" ~ (expr ~ ("," ~ expr)*)? ~ "]" }
tuple       = { "(" ~ expr ~ "," ~ expr ~ ("," ~ expr)* ~ ")" }

// Program structure
program     = { SOI ~ (statement ~ ";"?)* ~ EOI }
statement   = { error_type_decl | type_decl | let_decl | async_function_decl | function_decl | import_decl | export_decl | expr }

// Error type declaration (enum-like with variants)
error_type_decl = { "error" ~ identifier ~ "{" ~ error_variant_list? ~ "}" }
error_variant_list = { error_variant ~ ("," ~ error_variant)* ~ ","? }
error_variant = { identifier ~ (":" ~ (unit_type | ("{" ~ struct_field_list ~ "}")))? }

// Type declarations
type_decl   = { "type" ~ identifier ~ type_params? ~ "=" ~ type_definition }
type_definition = { union_type_def | struct_def | enum_def }
union_type_def = { type_annotation ~ ("|" ~ type_annotation)+ }
struct_def  = { "struct" ~ "{" ~ struct_field_list? ~ "}" }
struct_field_list = { struct_field ~ ("," ~ struct_field)* ~ ","? }
struct_field = { identifier ~ ":" ~ type_annotation }
enum_def    = { "enum" ~ "{" ~ enum_variant_list? ~ "}" }
enum_variant_list = { enum_variant ~ ("," ~ enum_variant)* ~ ","? }
enum_variant = { identifier ~ (("(" ~ type_annotation ~ ("," ~ type_annotation)* ~ ")") | ("{" ~ struct_field_list ~ "}"))? }

// Function declarations
function_decl = { "fn" ~ identifier ~ type_params? ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ "=" ~ expr }
async_function_decl = { "async" ~ "fn" ~ identifier ~ type_params? ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ "=" ~ expr }
type_params  = { "<" ~ identifier ~ ("," ~ identifier)* ~ ">" }
param_list   = { parameter ~ ("," ~ parameter)* }
parameter    = { identifier ~ (":" ~ type_annotation)? }

// Variable declarations
let_decl    = { "let" ~ identifier ~ (":" ~ type_annotation)? ~ ("=" ~ expr)? }

// Expression hierarchy (with proper operator precedence)
expr        = { assignment_expr | for_loop | while_loop | loop_expr | break_expr | continue_expr | binary_expr }

add_op        = { "+" | "-" }
mul_op        = { "*" | "/" | "%" }
bitwise_op    = { "&" | "|" | "^" | "<<" | ">>" }
bool_op       = { "&&" | "||" }
comp_op       = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
range_op      = { "..=" | ".." }
unary_op      = { "-" | "!" }

binary_expr   = { comparison_expr ~ (bool_op ~ comparison_expr)* }
comparison_expr = { additive_expr ~ (comp_op ~ additive_expr)* }
additive_expr = { multiplicative_expr ~ (add_op ~ multiplicative_expr)* }
multiplicative_expr = { bitwise_expr ~ (mul_op ~ bitwise_expr)* }
bitwise_expr = { pipe_expr ~ (bitwise_op ~ pipe_expr)* }
pipe_op       = { "|>" }
pipe_expr     = { range_expr ~ (pipe_op ~ range_expr)* }
range_expr    = { unary_expr ~ (range_op ~ unary_expr)? }
unary_expr    = { unary_op* ~ call_expr }
call_expr   = { primary ~ ( function_call | ("." ~ identifier) | ("[" ~ expr ~ "]") | postfix_op )* }

// Function call with parentheses (including empty calls)
function_call = { "(" ~ arg_list? ~ ")" }

// Function call arguments (different from tuple literals)
arg_list    = { expr ~ ("," ~ expr)* }

// Try-catch expressions
try_catch_expr = { "try" ~ block ~ "catch" ~ "(" ~ identifier ~ ")" ~ block }

// Postfix operators
postfix_op = { "?" }

primary     = { lambda | async_expr | await_expr | promise_expr | all_expr | race_expr | spawn_expr | match_expr | if_expr | try_catch_expr | struct_literal | anonymous_object | literal | identifier | "(" ~ expr ~ ")" | block }

// Lambda functions
lambda      = { "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ "=>" ~ (block | expr) }

// Async expressions
async_expr  = { "async" ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ "=>" ~ (block | expr) }
await_expr  = { "await" ~ call_expr }

// Promise expressions
promise_expr = { "Promise" ~ "." ~ promise_method ~ "(" ~ expr ~ ("," ~ expr)? ~ ")" }
promise_method = { "resolve" | "reject" | "delay" }

// Concurrent operations
all_expr    = { "Promise" ~ "." ~ "all" ~ "(" ~ "[" ~ arg_list? ~ "]" ~ ")" }
race_expr   = { "Promise" ~ "." ~ "race" ~ "(" ~ "[" ~ arg_list? ~ "]" ~ ")" }
spawn_expr  = { "spawn" ~ call_expr }

// Pattern matching
match_expr  = { "match" ~ expr ~ "{" ~ match_arm+ ~ "}" }
match_arm   = { pattern ~ ("if" ~ expr)? ~ "=>" ~ expr ~ (","?) }
pattern     = { or_pattern }
or_pattern  = { base_pattern ~ ("|" ~ base_pattern)* }
base_pattern = { range_pattern | result_pattern | enum_variant_pattern | struct_pattern | integer | string | boolean | wildcard | list_pattern | tuple_pattern | identifier }
range_pattern = { integer ~ ".." ~ ("=" ~ integer | integer) | char_literal ~ ".." ~ char_literal }
result_pattern = { "Ok" ~ "(" ~ pattern ~ ")" | "Err" ~ "(" ~ pattern ~ ")" }
enum_variant_pattern = { identifier ~ ("(" ~ pattern ~ ("," ~ pattern)* ~ ")")? }
struct_pattern = { identifier ~ "{" ~ struct_pattern_fields? ~ "}" }
struct_pattern_fields = { struct_pattern_field ~ ("," ~ struct_pattern_field)* ~ ","? }
struct_pattern_field = { (identifier ~ ":" ~ pattern) | identifier }
list_pattern = { "[" ~ (pattern ~ ("," ~ pattern)*)? ~ "]" }
tuple_pattern = { "(" ~ pattern ~ "," ~ pattern ~ ("," ~ pattern)* ~ ")" }
wildcard    = { "_" }

// Blocks and control flow
block       = { "{" ~ (statement ~ ";"?)* ~ "}" }

// Conditionals
if_expr     = { "if" ~ expr ~ "=>" ~ (block | expr) ~ ("else" ~ "=>" ~ (block | expr))? }

// Literals
literal     = { float | integer | string | raw_string | template_string | boolean | list | tuple }

// Built-in types (for future type system)
builtin_type = _{ "Int" | "Float" | "String" | "Bool" | "List" | "Tuple" }

// Type annotations
type_annotation = { union_type | intersection_type | literal_type | anonymous_struct_type | basic_type | unit_type | list_type | function_type | generic_type | result_type | promise_type | custom_type }
anonymous_struct_type = { "{" ~ struct_field_list? ~ "}" }
basic_type = { "Int" | "Float" | "String" | "Bool" }
unit_type = { "()" }
custom_type = { identifier }
generic_type = { identifier ~ "<" ~ type_annotation ~ ("," ~ type_annotation)* ~ ">" }
list_type = { "[" ~ type_annotation ~ "]" }
function_type = { "(" ~ (type_annotation ~ ("," ~ type_annotation)*)? ~ ")" ~ "->" ~ type_annotation }
result_type = { "Result" ~ "<" ~ type_annotation ~ "," ~ type_annotation ~ ">" }
promise_type = { "Promise" ~ "<" ~ type_annotation ~ ("," ~ type_annotation)? ~ ">" }
union_type = { basic_type ~ ("|" ~ basic_type)+ }
intersection_type = { basic_type ~ ("&" ~ basic_type)+ }
literal_type = { string | integer | boolean }

// Module statements
import_decl = { "import" ~ (import_items ~ "from")? ~ string }
import_items = { "{" ~ identifier ~ ("," ~ identifier)* ~ "}" | "*" }
export_decl = { "export" ~ identifier ~ "=" ~ expr }

// Struct expressions
struct_literal = { identifier ~ "{" ~ field_value_list? ~ "}" }
anonymous_object = { "{" ~ field_value_list? ~ "}" }
field_value_list = { field_value ~ ("," ~ field_value)* ~ ","? }
field_value = { identifier ~ ":" ~ expr }

// Loop constructs
for_loop    = { "for" ~ identifier ~ "in" ~ expr ~ block }
while_loop  = { "while" ~ expr ~ block }
loop_expr   = { "loop" ~ block }
break_expr  = { "break" }
continue_expr = { "continue" }

assignment_expr = { identifier ~ "=" ~ expr }
