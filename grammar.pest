// Olang Grammar Definition
// Supports functions, pipelines, pattern matching, and minimal syntax

WHITESPACE  = _{ " " | "\t" }
NL          = _{ NEWLINE | COMMENT }
NEWLINE     = _{ "\n" | "\r\n" }
COMMENT     = _{ "//" ~ (!NEWLINE ~ ANY)* }

// Keywords - these must not be parsed as identifiers
// Reserved words — never usable as identifiers.
//
// The seven declaration-position words (`share`, `error`, `test`, `type`,
// `trait`, `impl`, `use`) were freed in 0.64: each only ever introduces a
// declaration, and the token after it disambiguates, so PEG backtracking
// resolves `let type = row.kind` to an ordinary binding while `type Point
// = ...` still parses as a type declaration. They are common enough as
// variable names — a share of a total, an error term, a test case — that
// reserving them cost more than it bought.
keyword = { "fn" | "let" | "if" | "else" | "match" | "for" | "while" | "loop" | "break" | "continue" | "return" | "true" | "false" | "struct" | "enum" }

// Identifiers and literals - exclude keywords
identifier  = @{ !(keyword ~ !(ASCII_ALPHANUMERIC | "_")) ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
integer     = @{ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ !(ASCII_ALPHA | "_") }
float       = @{ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? ~ !(ASCII_ALPHA | "_") }
string      = @{ "\"" ~ string_char* ~ "\"" }
raw_string  = @{ "r\"" ~ ("\\\"" | (!"\"" ~ ANY))* ~ "\"" }
// Compound-atomic (`$`): no implicit WHITESPACE is consumed between the
// opening backtick and the content, so a template that begins with a
// space or tab keeps it — `  x` is "  x", not "x". Leading whitespace was
// silently stripped while this was a plain rule, asymmetric with trailing
// and interior whitespace, which are preserved. Inner tokens are still
// produced, so `template_raw_content` remains findable.
template_string = ${ "`" ~ template_raw_content ~ "`" }
template_raw_content = @{ (!"`" ~ ANY)* }
string_char = { !("\"" | "\\") ~ ANY | escape_sequence }

escape_sequence = { "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | "0" | "x" ~ ASCII_HEX_DIGIT{2} | "u" ~ ASCII_HEX_DIGIT{4} | "u{" ~ ASCII_HEX_DIGIT+ ~ "}") }
template_escape = { "\\" ~ ("`" | "$" | "\\") }
template_interpolation = { "${" ~ expr ~ "}" }
boolean     = { "true" | "false" }
char_literal = @{ "'" ~ (!"'" ~ ANY) ~ "'" }

// Enhanced numeric literals
binary      = @{ ("+" | "-")? ~ "0b" ~ ASCII_BIN_DIGIT+ ~ ("_" ~ ASCII_BIN_DIGIT+)* ~ !(ASCII_ALPHANUMERIC | "_") }
octal       = @{ ("+" | "-")? ~ "0o" ~ ASCII_OCT_DIGIT+ ~ ("_" ~ ASCII_OCT_DIGIT+)* ~ !(ASCII_ALPHANUMERIC | "_") }
hex         = @{ ("+" | "-")? ~ "0x" ~ ASCII_HEX_DIGIT+ ~ ("_" ~ ASCII_HEX_DIGIT+)* ~ !(ASCII_ALPHANUMERIC | "_") }
number      = { float | binary | octal | hex | integer }

// Lists and tuples
list        = { "[" ~ NL* ~ (expr ~ (NL* ~ "," ~ NL* ~ expr)* ~ NL* ~ ","? ~ NL*)? ~ "]" }
// Parenthesized expressions unify grouping `(e)` and tuples `(a, b, ...)` into a
// single rule so the inner expression list is parsed exactly ONCE. Previously
// `primary` had two `(`-prefixed alternatives — the `tuple` literal followed by
// the `"(" ~ expr ~ ")"` grouping — and a plain `(e)` made the tuple branch
// parse the whole inner expression, fail at the missing comma, then the grouping
// branch re-parse it. Nested `((((…))))` doubled that work at every level, giving
// catastrophic exponential-time backtracking (a 25-deep expression never
// returned). One expr child means a grouping; two or more means a tuple.
paren_expr  = { "(" ~ NL* ~ expr ~ (NL* ~ "," ~ NL* ~ expr)* ~ NL* ~ ")" }

// Program structure - Put share_decl and use_decl BEFORE expr to ensure they are matched first
program     = { SOI ~ NL* ~ (statement ~ (";" | NL)* )* ~ EOI }
statement   = { share_decl | use_decl | test_decl | error_type_decl | trait_decl | impl_decl | type_decl | let_decl | function_decl | assertion | expr }
function_decl = { "fn" ~ identifier ~ type_params? ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ "=" ~ NL* ~ expr }

// Share and use declarations - defined EARLY to get precedence
share_decl = { "share" ~ (use_decl | function_decl | let_decl | type_decl | trait_decl | impl_decl) }
use_decl = { "use" ~ use_path ~ ("{" ~ NL* ~ use_list ~ NL* ~ "}")? }
use_path = { identifier ~ ("." ~ identifier)* }
use_list = { use_item ~ (NL* ~ "," ~ NL* ~ use_item)* ~ (NL* ~ ",")? }
use_item = { wildcard | identifier }
wildcard = { "*" }

// Test declarations
test_decl = { "test" ~ string ~ test_block }
test_block = { "{" ~ NL* ~ (test_statement ~ (";" | NL)* )* ~ "}" }
test_statement = { statement }
// Assertions are a statement form, not a test-block form. They were once
// reachable only as a direct child of a test block, so `assert_eq` inside
// an `if`, a `for`, or a `while` fell through to an ordinary call and
// failed with "Undefined variable: assert_eq" — surprising, since a loop
// over cases is exactly where an assertion belongs.
//
// They also accept newlines between arguments, like every other call
// form; without that, a multi-line assert_eq silently parsed as a plain
// call to an undefined `assert_eq` function.
assertion = { assert_eq | assert_ne | assert | assert_true | assert_false }
assert_eq = { "assert_eq" ~ "(" ~ NL* ~ expr ~ NL* ~ "," ~ NL* ~ expr ~ (NL* ~ "," ~ NL* ~ string)? ~ NL* ~ ")" }
assert_ne = { "assert_ne" ~ "(" ~ NL* ~ expr ~ NL* ~ "," ~ NL* ~ expr ~ (NL* ~ "," ~ NL* ~ string)? ~ NL* ~ ")" }
assert = { "assert" ~ "(" ~ NL* ~ expr ~ (NL* ~ "," ~ NL* ~ string)? ~ NL* ~ ")" }
assert_true = { "assert_true" ~ "(" ~ NL* ~ expr ~ (NL* ~ "," ~ NL* ~ string)? ~ NL* ~ ")" }
assert_false = { "assert_false" ~ "(" ~ NL* ~ expr ~ (NL* ~ "," ~ NL* ~ string)? ~ NL* ~ ")" }

// Error type declaration (enum-like with variants)
error_type_decl = { "error" ~ identifier ~ "{" ~ error_variant_list? ~ "}" }
error_variant_list = { NL* ~ error_variant ~ (NL* ~ "," ~ NL* ~ error_variant)* ~ NL* ~ ","? ~ NL* }
error_variant = { identifier ~ (":" ~ (unit_type | ("{" ~ struct_field_list ~ "}")))? }

// Type declarations
type_decl   = { "type" ~ identifier ~ type_params? ~ "=" ~ type_definition }
type_definition = { union_type_def | struct_def | enum_def }
union_type_def = { type_annotation ~ ("|" ~ type_annotation)+ }
struct_def  = { "struct" ~ "{" ~ struct_field_list? ~ "}" }
struct_field_list = { NL* ~ struct_field ~ (NL* ~ "," ~ NL* ~ struct_field)* ~ NL* ~ ","? ~ NL* }
struct_field = { identifier ~ ":" ~ type_annotation }
enum_def    = { "enum" ~ "{" ~ enum_variant_list? ~ "}" }
enum_variant_list = { NL* ~ enum_variant ~ (NL* ~ "," ~ NL* ~ enum_variant)* ~ NL* ~ ","? ~ NL* }
enum_variant = { identifier ~ (("(" ~ type_annotation ~ ("," ~ type_annotation)* ~ ")") | ("{" ~ struct_field_list ~ "}"))? }

// Function declarations

// Traits (runtime-dispatched interfaces) and their implementations
trait_decl  = { "trait" ~ identifier ~ "{" ~ NL* ~ (trait_method ~ NL*)* ~ "}" }
trait_method = { "fn" ~ identifier ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ ("=" ~ NL* ~ expr)? }
impl_decl   = { "impl" ~ identifier ~ "for" ~ identifier ~ "{" ~ NL* ~ (function_decl ~ NL*)* ~ "}" }
type_params  = { "<" ~ type_param ~ ("," ~ type_param)* ~ ">" }
type_param   = { identifier ~ (":" ~ identifier ~ ("+" ~ identifier)*)? }
param_list   = { NL* ~ parameter ~ (NL* ~ "," ~ NL* ~ parameter)* ~ NL* }
parameter    = { identifier ~ (":" ~ type_annotation)? ~ ("=" ~ expr)? }

// Variable declarations. `mut` is a contextual keyword: it marks intent (all
// bindings are assignable), and must be followed by the actual binding.
// A let either has an initializer or ends the statement right there — the
// lookahead rejects `let scores #{...}` (a forgotten `=`), which would
// otherwise silently parse as an uninitialized binding plus a stray
// expression statement.
mut_kw      = @{ "mut" ~ !(ASCII_ALPHANUMERIC | "_") }
let_decl    = { "let" ~ mut_kw? ~ pattern ~ (":" ~ type_annotation)? ~ (("=" ~ NL* ~ expr) | &(";" | NEWLINE | COMMENT | "}" | EOI)) }

// Expression hierarchy (with proper operator precedence)
expr        = { assignment_expr | par_for_loop | for_loop | while_loop | loop_expr | break_expr | continue_expr | return_expr | binary_expr }

add_op        = { "+" | "-" }
mul_op        = { "*" | "/" | "%" }
bitwise_op    = { "&" | "|" | "^" | "<<" | ">>" }
bool_op       = { "&&" | "||" }
comp_op       = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
range_op      = { "..=" | ".." }
unary_op      = { "-" | "!" }

binary_expr   = { comparison_expr ~ (NL* ~ bool_op ~ NL* ~ comparison_expr)* }
comparison_expr = { additive_expr ~ (NL* ~ comp_op ~ NL* ~ cmp_rhs)* }
// The right of a comparison is the one place `()` must outrank the
// nullary-lambda reading. `if t == () => 0 else => 1` means "t is Unit,
// then this branch" — never "t equals a function" — but ordered choice
// would otherwise let `lambda` swallow the `=>` that belongs to the `if`.
// Comparing against a literal function is still writable, parenthesized.
cmp_rhs = { unit | additive_expr }
additive_expr = { multiplicative_expr ~ (NL* ~ add_op ~ NL* ~ multiplicative_expr)* }
multiplicative_expr = { bitwise_expr ~ (NL* ~ mul_op ~ NL* ~ bitwise_expr)* }
bitwise_expr = { pipe_expr ~ (NL* ~ bitwise_op ~ NL* ~ pipe_expr)* }
pipe_op       = { "|>" }
pipe_expr     = { range_expr ~ (NL* ~ pipe_op ~ NL* ~ range_expr)* }
range_expr    = { unary_expr ~ (range_op ~ unary_expr)? }
unary_expr    = { unary_op* ~ call_expr }
call_expr   = { primary ~ ( function_call | ("." ~ identifier) | ("[" ~ expr ~ "]") | postfix_op )* }

// Function call with parentheses (including empty calls)
function_call = { "(" ~ arg_list? ~ ")" }

// Function call arguments (different from tuple literals)
arg_list = { NL* ~ argument ~ (NL* ~ "," ~ NL* ~ argument)* ~ NL* }
argument = { named_arg | positional_arg }
positional_arg = { expr }
named_arg = { identifier ~ ":" ~ expr }

// Try-catch expressions

// Postfix operators
postfix_op = { "?" }

// Primary expressions
primary     = { lambda | spawn_expr | match_expr | if_expr | struct_literal | anonymous_object | map_literal | literal | identifier | paren_expr | block }

// Lambda functions
lambda      = { "(" ~ param_list? ~ ")" ~ ("->" ~ type_annotation)? ~ "=>" ~ NL* ~ (block | expr) }

// Background execution
spawn_expr  = { "spawn" ~ call_expr }

// Pattern matching
match_expr  = { "match" ~ expr ~ "{" ~ NL* ~ match_arm+ ~ "}" }
match_arm   = { pattern ~ ("if" ~ expr)? ~ "=>" ~ NL* ~ expr ~ NL* ~ ","? ~ NL* }
pattern     = { or_pattern }
or_pattern  = { base_pattern ~ ("|" ~ base_pattern)* }
// `unit` precedes tuple_pattern, which needs at least one element — so
// `()` matched nothing and a Unit value, which the language hands back
// from an empty branch and from `N | ()` fields, had no way to be tested.
base_pattern = { range_pattern | result_pattern | struct_pattern | anonymous_struct_pattern | integer | string | boolean | pattern_wildcard | unit | list_pattern | tuple_pattern | enum_variant_pattern | identifier }
range_pattern = { (integer ~ range_op ~ integer) | (char_literal ~ range_op ~ char_literal) }
result_pattern = { "Ok" ~ "(" ~ pattern ~ ")" | "Err" ~ "(" ~ pattern ~ ")" }
enum_variant_pattern = { identifier ~ "(" ~ pattern ~ ("," ~ pattern)* ~ ")" }
struct_pattern = { identifier ~ "{" ~ struct_pattern_fields? ~ "}" }
anonymous_struct_pattern = { "{" ~ struct_pattern_fields? ~ "}" }
struct_pattern_fields = { NL* ~ struct_pattern_field ~ (NL* ~ "," ~ NL* ~ struct_pattern_field)* ~ NL* ~ ","? ~ NL* }
struct_pattern_field = { (identifier ~ ":" ~ pattern) | identifier }
rest_pattern = { "..." ~ identifier }
list_pattern = { "[" ~ NL* ~ list_pattern_inner? ~ NL* ~ "]" }
list_pattern_inner = { (pattern ~ ("," ~ pattern)* ~ ("," ~ rest_pattern)?) | rest_pattern }
tuple_pattern = { "(" ~ pattern ~ "," ~ pattern ~ ("," ~ pattern)* ~ ")" }
pattern_wildcard    = { "_" }

// Blocks and control flow
block       = { "{" ~ NL* ~ (statement ~ (";" | NL)* )* ~ "}" }

// Conditionals
if_expr     = { "if" ~ expr ~ NL* ~ "=>" ~ NL* ~ (block | expr) ~ (NL* ~ "else" ~ NL* ~ (if_expr | ("=>" ~ NL* ~ (block | expr))))? }

// Literals
// `unit` precedes everything that could start with "(": paren_expr needs
// an expression inside, so `()` matched nothing and every use of the
// language's own Unit value was a parse error.
literal     = { unit | float | binary | octal | hex | integer | char_literal | raw_string | template_string | string | boolean | list }
unit        = { "(" ~ NL* ~ ")" }

// Built-in types (for future type system)
builtin_type = _{ "Int" | "Float" | "String" | "Bool" | "List" | "Tuple" }

// Type annotations
type_annotation = { union_type | intersection_type | literal_type | anonymous_struct_type | generic_type | result_type | function_type | tuple_type | list_type | map_type | basic_type | custom_type | unit_type }
// Union branches: everything except function types (whose `->` would be
// ambiguous with `|` precedence) and nested unions. Parameterized forms
// must come before custom_type, or a bare identifier match would strand
// their `<...>`.
base_type_annotation = { result_type | map_type | generic_type | list_type | tuple_type | unit_type | literal_type | basic_type | custom_type }
anonymous_struct_type = { "{" ~ struct_field_list? ~ "}" }
basic_type = { "Int" | "Float" | "String" | "Bool" | "Map" }
unit_type = { "()" }
custom_type = { identifier }
generic_type = { identifier ~ "<" ~ type_annotation ~ ("," ~ type_annotation)* ~ ">" }
list_type = { "[" ~ type_annotation ~ "]" }
map_type = { "Map" ~ "<" ~ type_annotation ~ "," ~ type_annotation ~ ">" }
tuple_type = { "(" ~ type_annotation ~ "," ~ type_annotation ~ ("," ~ type_annotation)* ~ ")" }
function_type = { "(" ~ (type_annotation ~ ("," ~ type_annotation)*)? ~ ")" ~ "->" ~ type_annotation }
result_type = { "Result" ~ "<" ~ type_annotation ~ "," ~ type_annotation ~ ">" }
union_type = { base_type_annotation ~ ("|" ~ base_type_annotation)+ }
intersection_type = { basic_type ~ ("&" ~ basic_type)+ }
literal_type = { string | integer | boolean }

// Struct expressions
struct_literal = { identifier ~ "{" ~ field_value_list? ~ "}" }
anonymous_object = { "{" ~ field_value_list? ~ "}" }
field_value_list = { NL* ~ field_value ~ (NL* ~ "," ~ NL* ~ field_value)* ~ NL* ~ ","? ~ NL* }
field_value = { identifier ~ ":" ~ expr }

// Map literals
map_literal = { "#{" ~ map_entry_list? ~ "}" }
map_entry_list = { NL* ~ map_entry ~ (NL* ~ "," ~ NL* ~ map_entry)* ~ NL* ~ ","? ~ NL* }
map_entry = { expr ~ ":" ~ expr }

// Loop constructs. The loop binding is a name or a tuple of names —
// `for (i, x) in enumerate(xs)` destructures each element.
for_loop    = { "for" ~ (for_binding_tuple | discard | identifier) ~ "in" ~ expr ~ block }
// `_` is a binding that discards. It is not an identifier — identifiers
// must start with a letter — so a loop that ignores its item needed a
// throwaway name until this existed.
discard     = @{ "_" ~ !(ASCII_ALPHANUMERIC | "_") }
// `par for` fans iterations across worker threads: spawn-style snapshot
// semantics, an implicit barrier at the end, Unit result. `par` is not a
// reserved word — it only means something directly before `for`.
par_for_loop = { "par" ~ "for" ~ (for_binding_tuple | discard | identifier) ~ "in" ~ expr ~ block }
for_binding_tuple = { "(" ~ identifier ~ ("," ~ identifier)+ ~ ")" }
while_loop  = { "while" ~ expr ~ block }
loop_expr   = { "loop" ~ block }
break_expr  = { "break" ~ expr? }
continue_expr = { "continue" }
return_expr = { "return" ~ expr? }

assignment_expr = { identifier ~ "=" ~ expr }
