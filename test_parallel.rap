// Test parallel processing with large lists
// This should now use multiple threads since we lowered the threshold to 100

// Create a large list to trigger parallel processing
small_list = range(15)
medium_list = range(500)
large_list = range(20000000)

println("Testing aggressive multi-threading with different list sizes:")

// Test map function with parallel processing
squared_small = map(small_list, (x) => x * x)
println("✅ Mapped 15 elements (should use multi-threading)")

// Test filter function with parallel processing  
evens_medium = filter(medium_list, (x) => x % 2 == 0)
println("✅ Filtered 50 elements (should use multi-threading)")

// Test sum function with parallel processing
total_large = sum(large_list)
println("✅ Sum of range(200): " + to_string(total_large))

// Test sort function with parallel processing
sorted_medium = sort(medium_list)
println("✅ Sorted 50 elements (should use multi-threading)")

// Test contains function with parallel processing
contains_result = contains(large_list, 150)
println("✅ Searched 200 elements for value 150: " + to_string(contains_result))

println("🚀 All operations completed with automatic multi-threading!") 