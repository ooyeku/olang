+                let node_id = self.ivars().node_id;
+                let platform_actions = actions
+                    .iter()
+                    .map(|action| {
+                        let handler =
+                            custom_action_handler(Rc::downgrade(context), node_id, action.id);
+                        let name = NSString::from_str(&action.description);
+                        unsafe {
+                            NSAccessibilityCustomAction::initWithName_handler(
+                                NSAccessibilityCustomAction::alloc(),
+                                &name,
+                                Some(&handler),
+                            )
+                        }
+                    })
+                    .collect::<Vec<_>>();
+                Some(NSArray::from_vec(platform_actions))
+            })
+            .flatten()
