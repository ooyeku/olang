+        fn custom_actions(&self) -> Option<Id<NSArray<NSAccessibilityCustomAction>>> {
+            self.resolve_with_context(|node, _, context| {
+                if !node.supports_action(Action::CustomAction, &filter) {
+                    return None;
+                }
+                let actions = node.data().custom_actions();
+                if actions.is_empty() {
+                    return None;
