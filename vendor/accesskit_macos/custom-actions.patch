+/// The handler of one custom action: it holds the context weakly, so an
+/// action object VoiceOver keeps after the tree or the window is gone does
+/// nothing, and it asks for the action only while the node still offers it.
+fn custom_action_handler(
+    context: Weak<Context>,
+    node_id: FullNodeId,
+    action_id: i32,
+) -> RcBlock<dyn Fn() -> Bool> {
+    RcBlock::new(move || -> Bool {
+        let Some(context) = context.upgrade() else {
+            return Bool::NO;
+        };
+        let request = {
+            let tree = context.tree.borrow();
+            let state = tree.state();
+            let Some(node) = state.node_by_id(node_id) else {
+                return Bool::NO;
+            };
+            if !node.supports_action(Action::CustomAction, &filter)
+                || !node
+                    .data()
+                    .custom_actions()
+                    .iter()
+                    .any(|action| action.id == action_id)
+            {
+                return Bool::NO;
+            }
+            let Some((target_node, target_tree)) = state.locate_node(node.id()) else {
+                return Bool::NO;
+            };
+            ActionRequest {
+                action: Action::CustomAction,
+                target_tree,
+                target_node,
+                data: Some(ActionData::CustomAction(action_id)),
+            }
+        };
+        context.do_action(request);
+        Bool::YES
+    })
+}
