<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for olang and otc when they are signed with a Developer ID
  and the hardened runtime (the release workflow does this only when the
  Apple secrets exist; see dist/signing/README.md). The JIT writes machine
  code at run time, which the hardened runtime forbids unless allowed, and
  native plugins are libraries signed by someone else.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
