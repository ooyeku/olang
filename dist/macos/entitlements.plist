<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for olang and otc when they are signed with a Developer ID
  and the hardened runtime (the release workflow does this only when the
  Apple secrets exist; see dist/signing/README.md).

  The JIT writes machine code at run time into memory mapped with MAP_JIT
  (src/ovm/jit_memory.rs), which the hardened runtime allows with
  allow-jit alone. Nothing else is needed: a binary signed without it
  still runs, with the JIT off. olang loads no libraries signed by anyone
  else, so library validation stays on.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
