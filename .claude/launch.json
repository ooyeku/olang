{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "olang-website",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "website",
        "preview"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "olang-website-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd website && exec bun run vite dev --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "tracker",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd examples/app && exec ../../target/debug/olang main.ol 7013 :memory:"
      ],
      "port": 7013
    },
    {
      "name": "tracker-olang",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd examples/app && exec ../../target/release/olang main.ol 7461"
      ],
      "port": 7461
    }
  ]
}