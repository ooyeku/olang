{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "olang-website",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "website",
        "preview"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "olang-website-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd website && exec bun run vite dev --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "tracker",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd examples/app && exec ../../target/debug/olang main.ol 7013 :memory:"
      ],
      "port": 7013
    },
    {
      "name": "tracker-olang",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd examples/app && exec ../../target/release/olang main.ol 7461"
      ],
      "port": 7461
    },
    {
      "name": "ledger",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd examples/ledger && exec ../../target/release/olang main.ol 7412 /private/tmp/claude-501/-Users-olayeku-Code-olang/be4d40c6-47c1-4251-af56-f8a90b73cd26/scratchpad/ledger_dev.db"
      ],
      "port": 7412
    }
  ]
}