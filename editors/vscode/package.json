{
  "name": "olang",
  "displayName": "olang",
  "description": "olang language support: syntax highlighting, diagnostics, completions, and formatting via the built-in language server (olang lsp).",
  "version": "0.2.0",
  "publisher": "ooyeku",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ooyeku/olang",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/ooyeku/olang/issues"
  },
  "homepage": "https://github.com/ooyeku/olang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "olang",
    "language server",
    "lsp",
    "syntax highlighting",
    "formatter"
  ],
  "activationEvents": [
    "onLanguage:olang"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "languages": [
      {
        "id": "olang",
        "aliases": [
          "olang"
        ],
        "extensions": [
          ".ol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "olang",
        "scopeName": "source.olang",
        "path": "./syntaxes/olang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "olang",
      "properties": {
        "olang.serverPath": {
          "type": "string",
          "default": "olang",
          "description": "Path to the olang binary (the server runs as `olang lsp`)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.2"
  }
}