{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "olang",
  "scopeName": "source.olang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#templates" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#modules" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.olang"
    },
    "templates": {
      "begin": "`",
      "end": "`",
      "name": "string.template.olang",
      "patterns": [
        { "match": "\\\\[`$\\\\]", "name": "constant.character.escape.olang" },
        {
          "begin": "\\$\\{",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.olang" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.olang" } },
          "name": "meta.embedded.expression.olang",
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "raw-strings": {
      "begin": "r\"",
      "end": "\"",
      "name": "string.quoted.raw.olang"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.olang",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.olang" }
      ]
    },
    "macros": {
      "patterns": [
        { "match": "\\bmeta(?=\\s+fn\\b)", "name": "keyword.declaration.meta.olang" },
        { "match": "@[a-z_][A-Za-z0-9_]*", "name": "entity.name.function.macro.olang" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(par(?=\\s+for)|for|while|loop|if|else|match|break|continue|return|in)\\b", "name": "keyword.control.olang" },
        { "match": "\\b(fn|let|mut|type|struct|enum|trait|impl|share|use|test|error)\\b", "name": "keyword.declaration.olang" },
        { "match": "\\bspawn\\b", "name": "keyword.other.concurrency.olang" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.olang" },
        { "match": "\\b(Ok|Err)\\b", "name": "support.class.result.olang" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(Int|Float|Bool|String|Unit|Any)\\b", "name": "support.type.primitive.olang" },
        { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.olang" }
      ]
    },
    "functions": {
      "patterns": [
        { "match": "(?<=\\bfn\\s)[a-z_][A-Za-z0-9_]*", "name": "entity.name.function.olang" },
        { "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()", "name": "entity.name.function.call.olang" }
      ]
    },
    "modules": {
      "match": "\\b(str|col|colx|math|mathx|json|toml|csv|re|dates|time|random|crypto|base64|fs|os|http|db|testing|ods|stats|plot|cell|chan|task|proc|caps|meta|cli|term|ui|viz|dash)(?=\\.)",
      "name": "support.module.olang"
    },
    "numbers": {
      "match": "\\b(0[bB][01_]+|0[oO][0-7_]+|0[xX][0-9a-fA-F_]+|\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?)\\b",
      "name": "constant.numeric.olang"
    },
    "operators": {
      "match": "\\|>|=>|->|==|!=|<=|>=|&&|\\|\\||\\.\\.=?|\\?|[+\\-*/%<>=!]",
      "name": "keyword.operator.olang"
    }
  }
}
