{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "olang",
  "scopeName": "source.olang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#modules" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.olang"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.olang",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.olang" },
        { "begin": "\\$\\{", "end": "\\}", "name": "meta.embedded.expression.olang", "patterns": [{ "include": "$self" }] }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(par(?=\\s+for)|for|while|loop|if|else|match|break|continue|return|in)\\b", "name": "keyword.control.olang" },
        { "match": "\\b(fn|let|mut|type|struct|enum|trait|impl|share|use|test|error)\\b", "name": "keyword.declaration.olang" },
        { "match": "\\b(async|await|spawn|try|catch)\\b", "name": "keyword.other.concurrency.olang" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.olang" },
        { "match": "\\b(Ok|Err|Some|None)\\b", "name": "support.class.result.olang" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(Int|Float|Bool|String|Unit)\\b", "name": "support.type.primitive.olang" },
        { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.olang" }
      ]
    },
    "functions": {
      "patterns": [
        { "match": "(?<=\\bfn\\s)[a-z_][A-Za-z0-9_]*", "name": "entity.name.function.olang" },
        { "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()", "name": "entity.name.function.call.olang" }
      ]
    },
    "modules": {
      "match": "\\b(str|col|colx|math|mathx|json|csv|re|dates|time|random|crypto|base64|fs|os|http|db|testing|ods|stats|plot)(?=\\.)",
      "name": "support.module.olang"
    },
    "numbers": {
      "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?\\b",
      "name": "constant.numeric.olang"
    },
    "operators": {
      "match": "\\|>|=>|->|==|!=|<=|>=|&&|\\|\\||\\.\\.=?|[+\\-*/%<>=!]",
      "name": "keyword.operator.olang"
    }
  }
}
