# Rust build output
/target/
**/*.rs.bk
*.pdb

# Claude Code session config (machine-local)
.claude/

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Logs, except an example fixture a program reads by default
*.log
logs/
!examples/data-processing/loganalyzer/data/app.log

# Local environment and temporary files
.env
*.tmp
*.temp

# Node (editors/vscode, the playground harnesses)
node_modules/
*.tgz

# olang
.olang_history
*.rap.bak

# Editor extension build output (editors/)
editors/vscode/*.vsix
editors/vscode/dist/
editors/zed/target/
editors/zed/grammars/
editors/zed/extension.wasm

# Example runtime data: databases, backups, generated charts, caches
examples/**/*.db
examples/web/app/backups/
examples/data-processing/statlab/*.svg
examples/data-processing/meterflow/cache/

# `olang build` output inside examples: a built binary is named after its
# entry point's directory.
examples/*/*/main
examples/*/*/ledger

# Local release staging (make dist). The Homebrew formula template and the
# Linux verification script stay tracked.
/dist/*
!/dist/homebrew/
!/dist/linux-verify.sh
