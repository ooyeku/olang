// Testing stdlib module demonstration
println("=== Testing Module Demo ===")

// Basic assertions
println("\n1. Basic equality assertions:")
let result1 = testing.assert_eq(42, 42)
println("testing.assert_eq(42, 42): " + to_string(result1))

let result2 = testing.assert_ne(42, 24)  
println("testing.assert_ne(42, 24): " + to_string(result2))

println("\n2. Boolean assertions:")
let result3 = testing.assert_true(5 > 3)
println("testing.assert_true(5 > 3): " + to_string(result3))

let result4 = testing.assert_false(3 > 5)
println("testing.assert_false(3 > 5): " + to_string(result4))

println("\n3. Result assertions:")
let ok_value = Ok("success")
let err_value = Err("failure")

let result5 = testing.assert_ok(ok_value)
println("testing.assert_ok(Ok('success')): " + to_string(result5))

let result6 = testing.assert_err(err_value)
println("testing.assert_err(Err('failure')): " + to_string(result6))

println("\n4. Test utilities:")
println("Test summary: " + testing.test_summary())

// Test a failing assertion to see error message
println("\n5. Demonstrating failure (expected):")
let failed_result = testing.assert_eq(42, 24)
println("testing.assert_eq(42, 24): " + to_string(failed_result))

println("\n=== Testing Demo Complete ===") 