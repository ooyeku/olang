// Simple Async Test for Olang
println("=== Simple Async Test ===")

// Test 1: Async function declaration
async fn simple_fetch() -> Promise<String> = {
    "Hello from async function"
}

println("1. Async function declared successfully")
let result = simple_fetch()
println("Async function result:", result)

// Test 2: Basic await expression  
let data = await simple_fetch()
println("2. Await result:", data)

// Test 3: Async lambda
let async_lambda = async () => "Hello from async lambda"
let lambda_result = await async_lambda()
println("3. Async lambda result:", lambda_result)

println("=== Simple Async Test Complete ===") 