// OVM Integration Demo
// This example demonstrates the enhanced performance capabilities
// of the Olang Virtual Machine (OVM) with lazy evaluation and optimization

// Large data processing - perfect for lazy evaluation
let large_range = range(1, 10000)

// Function that will benefit from JIT compilation
fn expensive_computation(n) {
    let result = 0
    for i in range(1, n) {
        result = result + i * i + math.sqrt(i)
    }
    result
}

// Chain operations - demonstrates lazy evaluation fusion
let processed_data = large_range
    |> map(fn(x) { x * 2 })
    |> filter(fn(x) { x % 3 == 0 })
    |> map(fn(x) { expensive_computation(x % 100) })
    |> take(50)

println("Processing large dataset with lazy evaluation...")

// Force evaluation to see the results
let results = processed_data |> take(10)
println("First 10 results: ${results}")

// Demonstrate function compilation benefits
println("Running performance test...")

let iterations = 1000
let start_time = dates.now()

for i in range(1, iterations) {
    expensive_computation(100)
}

let end_time = dates.now()
println("Completed ${iterations} iterations")

// Large list operations that benefit from OVM
println("Testing list operations...")

let large_list = range(1, 5000) |> map(fn(x) { x * x })
let filtered = large_list |> filter(fn(x) { x % 7 == 0 })
let sum_result = filtered |> take(100) |> sum()

println("Sum of first 100 squares divisible by 7: ${sum_result}")

// Nested function calls - good for optimization
fn fibonacci(n) {
    if n <= 1 {
        n
    } else {
        fibonacci(n - 1) + fibonacci(n - 2)
    }
}

// This will trigger JIT compilation
println("Computing Fibonacci numbers...")
let fib_results = range(1, 25) |> map(fibonacci) |> take(10)
println("First 10 Fibonacci numbers: ${fib_results}")

// Demonstrate memory management
println("Testing memory pressure...")
let memory_intensive = range(1, 1000)
    |> map(fn(x) { 
        range(1, x % 50) |> map(fn(y) { [x, y, x * y] })
    })
    |> flatten()
    |> take(500)

println("Memory test completed: ${memory_intensive |> len()} items")

// String processing
let text_data = range(1, 100)
    |> map(fn(x) { "Item number ${x}" })
    |> filter(fn(s) { s |> contains("5") })

println("Filtered text items: ${text_data |> len()} items")

println("OVM Integration Demo completed!")
println("Run with different execution modes to compare performance:")
println("  otc ovm examples/ovm_integration_demo.rap --mode=classic")
println("  otc ovm examples/ovm_integration_demo.rap --mode=ovm")
println("  otc ovm examples/ovm_integration_demo.rap --mode=benchmark") 