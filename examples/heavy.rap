let n = 1..100

for number in n { 
    n |> map((x) => x * math.pow(x, v)) |> filter((x) => x % 2 == 0) |> sum() |> println()
    let data = 1..10 |> map((x) => x * math.pow(x, v)) |> filter((x) => x % 2 == 0) |> sum()
    n |> map((x) => x * math.pow(x, v)) |> filter((x) => x % 2 == 0) |> sum() |> println()   
    println(math.pow(number, number))
    let p = 0
    while p < 3 {
        let v = random.choice(n)
        n |> map((x) => x * math.pow(x, v)) |> filter((x) => x % 2 == 0) |> sum() |> println()
        let data = 1..100 |> map((x) => x * math.pow(x, v)) |> filter((x) => x % 2 == 0) |> sum()
        p = p + 1
        println("p: " + p)
        println(is_even(p))
        println(is_odd(p))
        println(is_between(p, 0, 3))
        println(math.pow(p, p))
    }
}





