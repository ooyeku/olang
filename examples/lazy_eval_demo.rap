// Lazy Evaluation Demo for Olang
// This demonstrates the transparent lazy evaluation system

// Large range operations that would be memory-intensive without lazy evaluation
println("=== Lazy Range Operations ===")

// This would normally create a million-element list in memory
// With lazy evaluation, it only creates the range when needed
let large_range = 1..1000000

// Pipeline operations become lazy - no intermediate lists created
let result = large_range
    |> filter((x) => x % 2 == 0)  // Only even numbers
    |> map((x) => x * x)          // Square them
    |> take(10)                   // Take first 10
    |> sum()                      // Sum them up

println("Sum of first 10 squared even numbers: " + result)

// Demonstrate that lazy evaluation is transparent
println("\n=== Transparency Test ===")
let small_range = 1..10
println("Small range (eager): " + small_range)

// Same operations work on both lazy and eager ranges
let small_result = small_range
    |> filter((x) => x % 2 == 0)
    |> map((x) => x * x)

println("Squared even numbers: " + small_result)

// Memory-efficient data processing
println("\n=== Memory Efficiency ===")

// This would consume minimal memory even for huge datasets
let processed_data = 1..100000
    |> map((x) => x * 2)
    |> filter((x) => x > 1000)
    |> map((x) => x / 10)
    |> filter((x) => x % 3 == 0)

println("Processed data length: " + len(processed_data))
println("First 5 elements: " + take(processed_data, 5))

// Lazy evaluation with user-defined functions
println("\n=== User-Defined Functions ===")

fn is_prime(n) {
    if n < 2 { return false }
    if n == 2 { return true }
    if n % 2 == 0 { return false }
    
    let i = 3
    while i * i <= n {
        if n % i == 0 { return false }
        i = i + 2
    }
    true
}

// Find first 10 prime numbers in a large range
let primes = 2..10000
    |> filter(is_prime)
    |> take(10)

println("First 10 primes: " + primes)

// Demonstrate fusion optimization
println("\n=== Fusion Optimization ===")

// Multiple operations get fused into single pass
let fused_result = 1..1000
    |> filter((x) => x % 2 == 0)
    |> map((x) => x * 3)
    |> filter((x) => x > 100)
    |> take(5)

println("Fused operations result: " + fused_result)

println("\n=== Lazy Evaluation Complete ===")
println("All operations completed with minimal memory usage!") 