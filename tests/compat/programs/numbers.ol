// compat: number semantics — 64-bit integers that trap on overflow,
// floats that print read-back-clean and trap rather than make NaN or inf,
// strict Int/Float, lossless-or-loud JSON numbers.

println(9223372036854775807)
println(is_err(attempt(() => 9223372036854775807 + 1)))
println(is_err(attempt(() => 1 / 0)))
println(-9223372036854775807 - 1)
println(7 / 2)
println(-7 / 2)
println(-7 % 2)
println(0.1 + 0.2)
println(1.0 / 3.0)
println(1e300 * 10.0)
println(is_err(attempt(() => 1e308 * 10.0)))
println(is_err(attempt(() => 0.0 / 0.0)))
println(is_err(attempt(() => math.sqrt(-1.0))))
println(to_string(2.0))
println(to_float(3))
println(to_int(3.9))
println(5 == 5.0)
println(typeof(5) + " " + typeof(5.0))
println(str.parse_float("2.5e-3"))
println(math.floor(-2.5))
println(math.round(2.5))
println(math.pow(2.0, 10.0))
println(math.abs(-3))
println(math.max(3, 9))
println(math.gcd(12, 18))
let parsed = json.parse("{\"big\": 123456789012345678, \"f\": 0.5}")
println(parsed)
println(is_err(json.parse("99999999999999999999999")))
println(bigint.pow(bigint.of(2), 100))
println(bigint.parse("123456789012345678901234567890"))
